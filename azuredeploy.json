{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "1765050071455237013"
    }
  },
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "aks-dev",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "Name of the AKS cluster."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the AKS cluster."
      }
    },
    "nodeCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 5,
      "metadata": {
        "description": "Number of nodes in the system node pool."
      }
    },
    "nodeVmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ms",
      "allowedValues": [
        "Standard_B2ms",
        "Standard_B4ms",
        "Standard_D2s_v3",
        "Standard_D4s_v3"
      ],
      "metadata": {
        "description": "VM size for the node pool."
      }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 32,
      "minValue": 32,
      "maxValue": 128,
      "metadata": {
        "description": "OS disk size in GB."
      }
    },
    "enableAutoScaling": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable cluster autoscaler."
      }
    },
    "minNodeCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 3,
      "metadata": {
        "description": "Minimum node count (used when autoscaling is enabled)."
      }
    },
    "maxNodeCount": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 5,
      "metadata": {
        "description": "Maximum node count (used when autoscaling is enabled)."
      }
    },
    "networkPlugin": {
      "type": "string",
      "defaultValue": "kubenet",
      "allowedValues": [
        "kubenet",
        "azure"
      ],
      "metadata": {
        "description": "Network plugin for the cluster."
      }
    },
    "enableRbac": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Kubernetes RBAC."
      }
    },
    "enableAzureMonitor": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Azure Monitor / Container Insights."
      }
    },
    "deployWebApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the AKS Learn WebApp (Microsoft Learn MCP) into the cluster via GitOps in the same deployment."
      }
    },
    "webappImage": {
      "type": "string",
      "defaultValue": "ghcr.io/ingrammicrocloudde/aks-learn-webapp:latest",
      "minLength": 10,
      "metadata": {
        "description": "Container image for the WebApp. Keep default to use the prebuilt public image."
      }
    },
    "mcpServerUrl": {
      "type": "string",
      "defaultValue": "https://learn.microsoft.com/api/mcp",
      "metadata": {
        "description": "Microsoft Learn MCP Server endpoint used by the WebApp."
      }
    },
    "fluxConfigurationName": {
      "type": "string",
      "defaultValue": "aks-learn-webapp",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "Internal name for the GitOps (Flux) configuration object."
      }
    },
    "kubernetesNamespace": {
      "type": "string",
      "defaultValue": "webapp",
      "metadata": {
        "description": "Kubernetes namespace where the WebApp will be deployed."
      }
    },
    "gitRepositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/ingrammicrocloudde/setup-aks",
      "metadata": {
        "description": "Git repository URL containing the Kubernetes manifests."
      }
    },
    "gitRepositoryBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Git branch to track."
      }
    },
    "kustomizationPath": {
      "type": "string",
      "defaultValue": "./webapp/k8s",
      "metadata": {
        "description": "Repo path with Kubernetes manifests."
      }
    },
    "sourceSyncIntervalSeconds": {
      "type": "int",
      "defaultValue": 120,
      "minValue": 60,
      "metadata": {
        "description": "Sync interval for the Git source (seconds)."
      }
    },
    "kustomizationSyncIntervalSeconds": {
      "type": "int",
      "defaultValue": 120,
      "minValue": 60,
      "metadata": {
        "description": "Sync interval for kustomization reconciliation (seconds)."
      }
    },
    "reconciliationWaitDuration": {
      "type": "string",
      "defaultValue": "PT30M",
      "metadata": {
        "description": "How long to wait for flux reconciliation to complete (ISO 8601 duration)."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Environment": "dev",
        "ManagedBy": "ARM"
      },
      "metadata": {
        "description": "Tags to apply to all resources."
      }
    }
  },
  "variables": {
    "nodeResourceGroup": "[format('MC_{0}_{1}_{2}', resourceGroup().name, parameters('clusterName'), parameters('location'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2024-02-01",
      "name": "[parameters('clusterName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Base",
        "tier": "Free"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "dnsPrefix": "[parameters('clusterName')]",
        "nodeResourceGroup": "[variables('nodeResourceGroup')]",
        "enableRBAC": "[parameters('enableRbac')]",
        "agentPoolProfiles": [
          "[union(createObject('name', 'systempool', 'count', parameters('nodeCount'), 'vmSize', parameters('nodeVmSize'), 'osDiskSizeGB', parameters('osDiskSizeGB'), 'osDiskType', 'Managed', 'osType', 'Linux', 'mode', 'System', 'enableAutoScaling', parameters('enableAutoScaling'), 'availabilityZones', createArray(), 'nodeTaints', createArray()), if(parameters('enableAutoScaling'), createObject('minCount', parameters('minNodeCount'), 'maxCount', parameters('maxNodeCount')), createObject()))]"
        ],
        "networkProfile": {
          "networkPlugin": "[parameters('networkPlugin')]",
          "loadBalancerSku": "standard"
        },
        "addonProfiles": {
          "omsagent": {
            "enabled": "[parameters('enableAzureMonitor')]"
          }
        }
      }
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.KubernetesConfiguration/extensions",
      "apiVersion": "2023-05-01",
      "scope": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
      "name": "flux",
      "properties": {
        "extensionType": "microsoft.flux",
        "autoUpgradeMinorVersion": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.KubernetesConfiguration/fluxConfigurations",
      "apiVersion": "2023-05-01",
      "scope": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
      "name": "[parameters('fluxConfigurationName')]",
      "properties": {
        "scope": "cluster",
        "namespace": "[parameters('kubernetesNamespace')]",
        "sourceKind": "GitRepository",
        "gitRepository": {
          "url": "[parameters('gitRepositoryUrl')]",
          "repositoryRef": {
            "branch": "[parameters('gitRepositoryBranch')]"
          },
          "syncIntervalInSeconds": "[parameters('sourceSyncIntervalSeconds')]",
          "timeoutInSeconds": 60
        },
        "kustomizations": {
          "webapp": {
            "path": "[parameters('kustomizationPath')]",
            "prune": true,
            "force": false,
            "postBuild": {
              "substitute": {
                "WEBAPP_IMAGE": "[parameters('webappImage')]",
                "MCP_SERVER_URL": "[parameters('mcpServerUrl')]"
              }
            },
            "syncIntervalInSeconds": "[parameters('kustomizationSyncIntervalSeconds')]",
            "retryIntervalInSeconds": 60,
            "timeoutInSeconds": 120
          }
        },
        "waitForReconciliation": true,
        "reconciliationWaitDuration": "[parameters('reconciliationWaitDuration')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName')), 'Microsoft.KubernetesConfiguration/extensions', 'flux')]"
      ]
    }
  ],
  "outputs": {
    "clusterName": {
      "type": "string",
      "value": "[parameters('clusterName')]"
    },
    "clusterResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]"
    },
    "controlPlaneFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName')), '2024-02-01').fqdn]"
    },
    "kubeletIdentityObjectId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName')), '2024-02-01').identityProfile.kubeletidentity.objectId]"
    },
    "webAppDeployed": {
      "type": "bool",
      "value": "[parameters('deployWebApp')]"
    },
    "fluxConfigurationResourceId": {
      "type": "string",
      "value": "[if(parameters('deployWebApp'), extensionResourceId(resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName')), 'Microsoft.KubernetesConfiguration/fluxConfigurations', parameters('fluxConfigurationName')), '')]"
    }
  }
}