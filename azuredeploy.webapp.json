{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "16811495527368337821"
    }
  },
  "parameters": {
    "aksClusterName": {
      "type": "string",
      "metadata": {
        "description": "Existing AKS cluster name from the first deployment button (example: aks-dev)."
      }
    },
    "fluxConfigurationName": {
      "type": "string",
      "defaultValue": "aks-learn-webapp",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "Internal name for GitOps link object. Keep default unless you need multiple web app configs."
      }
    },
    "kubernetesNamespace": {
      "type": "string",
      "defaultValue": "webapp",
      "metadata": {
        "description": "Kubernetes namespace where the web app will be deployed (example: webapp)."
      }
    },
    "gitRepositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/ingrammicrocloudde/setup-aks",
      "metadata": {
        "description": "Git repository URL containing the Kubernetes manifests. Normally keep default for this repo."
      }
    },
    "gitRepositoryBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Git branch to track (example: main)."
      }
    },
    "kustomizationPath": {
      "type": "string",
      "defaultValue": "./webapp/k8s",
      "metadata": {
        "description": "Repo path with Kubernetes manifests (example: ./webapp/k8s)."
      }
    },
    "webappImage": {
      "type": "string",
      "minLength": 10,
      "metadata": {
        "description": "Required container image for deployment. Examples: myacr.azurecr.io/aks-learn-webapp:v1 or ghcr.io/my-org/aks-learn-webapp:latest"
      }
    },
    "mcpServerUrl": {
      "type": "string",
      "defaultValue": "https://learn.microsoft.com/api/mcp",
      "metadata": {
        "description": "Microsoft Learn MCP Server endpoint used by the WebApp."
      }
    },
    "sourceSyncIntervalSeconds": {
      "type": "int",
      "defaultValue": 120,
      "minValue": 60,
      "metadata": {
        "description": "Sync interval for the Git source (seconds)."
      }
    },
    "kustomizationSyncIntervalSeconds": {
      "type": "int",
      "defaultValue": 120,
      "minValue": 60,
      "metadata": {
        "description": "Sync interval for kustomization reconciliation (seconds)."
      }
    },
    "reconciliationWaitDuration": {
      "type": "string",
      "defaultValue": "PT30M",
      "metadata": {
        "description": "Maximum time to wait for Flux reconciliation (ISO 8601 duration, for example PT30M)."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.KubernetesConfiguration/fluxConfigurations",
      "apiVersion": "2023-05-01",
      "scope": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('aksClusterName'))]",
      "name": "[parameters('fluxConfigurationName')]",
      "properties": {
        "scope": "cluster",
        "namespace": "[parameters('kubernetesNamespace')]",
        "sourceKind": "GitRepository",
        "gitRepository": {
          "url": "[parameters('gitRepositoryUrl')]",
          "repositoryRef": {
            "branch": "[parameters('gitRepositoryBranch')]"
          },
          "syncIntervalInSeconds": "[parameters('sourceSyncIntervalSeconds')]",
          "timeoutInSeconds": 60
        },
        "kustomizations": {
          "webapp": {
            "path": "[parameters('kustomizationPath')]",
            "prune": true,
            "force": false,
            "postBuild": {
              "substitute": {
                "WEBAPP_IMAGE": "[parameters('webappImage')]",
                "MCP_SERVER_URL": "[parameters('mcpServerUrl')]"
              }
            },
            "syncIntervalInSeconds": "[parameters('kustomizationSyncIntervalSeconds')]",
            "retryIntervalInSeconds": 60,
            "timeoutInSeconds": 120
          }
        },
        "waitForReconciliation": true,
        "reconciliationWaitDuration": "[parameters('reconciliationWaitDuration')]"
      }
    }
  ],
  "outputs": {
    "fluxConfigurationResourceId": {
      "type": "string",
      "value": "[extensionResourceId(resourceId('Microsoft.ContainerService/managedClusters', parameters('aksClusterName')), 'Microsoft.KubernetesConfiguration/fluxConfigurations', parameters('fluxConfigurationName'))]"
    },
    "nextStep": {
      "type": "string",
      "value": "Wait for GitOps reconciliation to complete, then access the WebApp via the configured ingress."
    }
  }
}